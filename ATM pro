package com.pack1;

import java.util.Scanner;

public class ATM 
{

    public static void main(String[] args) 
    {

        Scanner sc = new Scanner(System.in);
        
        System.out.print("Set your PIN: ");
        int pin = sc.nextInt();

        System.out.print("Enter initial balance: ");
        double balance = sc.nextDouble();

        System.out.println("\n--- ATM is Ready ---\n");
        System.out.print("Enter PIN to Login: ");
        int enteredPin = sc.nextInt();

        if (enteredPin != pin) 
        {
            System.out.println("Oops!!! Incorrect PIN, Access Denied.");
            return;
        }

        while (true)
        {

            System.out.println("\n===== ATM MENU =====");
            System.out.println("1. Check Balance");
            System.out.println("2. Deposit Money");
            System.out.println("3. Withdraw Money");
            System.out.println("4. Change PIN");
            System.out.println("5. Exit");
            System.out.print("Choose an option: ");

            int choice = sc.nextInt();

            switch (choice)
            {

                case 1:
                    System.out.println("Your current balance is: " + balance + "Rupees");
                    break;

                case 2:
                    System.out.print("Enter amount to deposit: ");
                    double dep = sc.nextDouble();

                    if (dep <= 0) {
                        System.out.println(" Invalid amount!");
                    } else {
                        balance += dep;
                        System.out.println( dep + " Rupees deposited successfully!");
                    }
                    break;

                case 3:
                    System.out.print("Enter amount to withdraw: ");
                    double wd = sc.nextDouble();

                    if (wd <= 0) 
                    {
                        System.out.println(" Invalid amount!");
                    } 
                    else if (wd > balance) 
                    {
                        System.out.println("Insufficient balance!");
                    } 
                    else
                    {
                        balance -= wd;
                        System.out.println( wd + " Rupees withdrawn successfully!");
                    }
                    break;

                case 4:
                    System.out.print("Enter new PIN: ");
                    pin = sc.nextInt();
                    System.out.println("PIN changed successfully!");
                    break;

                case 5:
                    System.out.println("Thank you for using ATM! Goodbye!");
                    return;

                default:
                    System.out.println(" Invalid choice! Try again.");
            }
        }
    }
}
